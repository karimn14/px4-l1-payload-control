
<sdf version="1.9">
  <model name="payload_box_1_2kg">

    <link name="payload_link">
      <inertial>
        <mass>1.2</mass>   <!-- 1.2 kg sesuai skenario medis -->
        <inertia>
          <!-- Kotak 0.1x0.1x0.1 m, m=1.2 kg → I = m*a²/6 = 1.2*0.01/6 ≈ 0.002 -->
          <ixx>0.002</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.002</iyy>
          <iyz>0</iyz>
          <izz>0.002</izz>
        </inertia>
      </inertial>

      <collision name="payload_collision">
        <geometry>
          <box>
            <size>0.1 0.1 0.1</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <!-- Sedikit compliance agar tidak bouncing saat jatuh -->
              <kp>1e4</kp>
              <kd>10</kd>
            </ode>
          </contact>
        </surface>
      </collision>

      <visual name="payload_visual">
        <geometry>
          <box>
            <size>0.1 0.1 0.1</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.2 0.2 1</ambient>
          <diffuse>0.8 0.2 0.2 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <!-- Marker visual kecil di atas box — bantu align drone saat descend -->
      <visual name="top_marker">
        <pose>0 0 0.055 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.015</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1 1 0 1</ambient>
          <diffuse>1 1 0 1</diffuse>
        </material>
      </visual>
    </link>

  </model>
</sdf>
