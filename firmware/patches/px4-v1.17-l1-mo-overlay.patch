+# --- samakan dengan drone asli supaya terbang stabil di SIH ---
+param set-default SIH_MASS  2.064          # massa drone-mu (kg) nama param BENAR
+param set-default SIH_T_MAX 7.0            # ~ L1MO_F_MAX(27.8N)/4 motor. Naikkan kalau hover lemot.
+
+# Square quadrotor X (PX4 numbering)
