diff --git a/msg/L1MoDebug.msg b/msg/L1MoDebug.msg
new file mode 100644
index 0000000000..d3d13168e7
--- /dev/null
+++ b/msg/L1MoDebug.msg
@@ -0,0 +1,40 @@
+# l1_mo_debug.msg
+# L1 Adaptive Control + Hybrid Mass Estimator debug topic
+# Place at: ~/PX4-main/msg/l1_mo_debug.msg
+# After editing this file: clean rebuild required (rm -rf build/ then make)
+
+uint64 timestamp                # time since system start (microseconds)
+
+# ── L1 Adaptive State (per-axis: 0=X, 1=Y, 2=Z) ──
+float32[3] sigma_hat            # disturbance estimate σ̂ (m/s²)
+float32[3] pos_hat              # predicted position ẑ (m, NED)
+float32[3] vel_hat              # predicted velocity v̂ (m/s, NED)
+float32[3] u_filt               # filtered control output u_filt
+float32[3] pred_err_pos         # predictor position error ẑ-z (m)
+float32[3] pred_err_vel         # predictor velocity error v̂-vz (m/s)
+
+# ── Momentum Observer ──
+float32 mo_m_est                # MO mass estimate (kg)
+float32 mo_vz_filt              # filtered vertical velocity (m/s)
+float32 thrust_norm
+
+# ── Hybrid Mass Estimator (NEW) ──
+float32 hover_m_est             # hover throttle estimator mass (kg)
+float32 fused_m_est             # final fused mass used by controller (kg)
+uint8 hover_est_valid           # 1 = hover estimator converged
+
+# ── Event-Triggered Control (NEW) ──
+uint8 etc_triggered             # 1 = ETC allowed attitude update this cycle
+float32 etc_delta_phi           # |φ_now - φ_last| (degrees, before ETC decision)
+float32 etc_delta_theta         # |θ_now - θ_last| (degrees)
+float32 etc_delta_u1            # |U1_now - U1_last| (N)
+
+# ── Status ──
+uint8 is_airborne               # 1 = drone is in the air
+uint8 mo_enabled                # 1 = MO/hybrid estimator enabled via param
+
+float32 roll_deg
+float32 pitch_deg
+float32 roll_cmd_deg
+float32 pitch_cmd_deg
+float32 yaw_cmd_deg
